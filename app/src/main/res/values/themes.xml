<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme inheriting from AppCompat to prevent crashes in AppCompat activities -->
    <style name="Theme.MyApplication" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>

    <!-- Dedicated Fullscreen Theme for VLC-grade PlayerActivity -->
    <style name="Theme.PlayerActivity" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>

